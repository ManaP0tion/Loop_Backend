# application-local.yaml.example
# 사용법: 이 파일을 복사해서 application-local.yaml로 이름 바꿔서 사용하세요

spring:
  application:
    name: Loop_Backend

  datasource:
    url: jdbc:h2:mem:testdb
    driver-class-name: org.h2.Driver
    username: sa
    password:

  h2:
    console:
      enabled: true
      path: /h2-console

  jpa:
    database-platform: org.hibernate.dialect.H2Dialect
    hibernate:
      ddl-auto: create-drop
    show-sql: true
    properties:
      hibernate:
        format_sql: true

  mail:
    host: smtp.gmail.com
    port: 587
    username: your-gmail-address@gmail.com
    password: your-gmail-app-password

# 로컬에서는 SES 대신 지메일 계정을 그대로 재사용해도 됨 (검증된 SES 발신 주소가 없다면)
ses:
  mail:
    host: smtp.gmail.com
    port: 587
    username: your-gmail-address@gmail.com
    password: your-gmail-app-password
    from: your-gmail-address@gmail.com

springdoc:
  api-docs:
    path: /v3/api-docs
  swagger-ui:
    path: /swagger-ui.html
    operations-sorter: method
    tags-sorter: alpha

jwt:
  secret: local-secret-key-for-testing-only-12345678
  expiration: 86400000

kakao:
  client-id: local-kakao-client-id
  allowed-redirect-uris: http://localhost:8080/api/auth/kakao/callback,http://localhost:3000/oauth/callback
  client-secret: local-kakao-client-secret
  auth-url: https://kauth.kakao.com
  api-url: https://kapi.kakao.com

frontend:
  url: http://localhost:3000

kopis:
  api-key: YOUR_KOPIS_API_KEY_HERE

report:
  admin-email: your-admin-email@example.com
